# Flask environment
# Set FLASK_DEBUG=1 during development to enable Flask's debug mode;
# keep it off (0) in production. Do not run the debugger publicly.
FLASK_DEBUG=0

# Used by Flask for session signing. Replace before deploying.
SECRET_KEY=change-this-value

# Minimum cosine-similarity score required to accept an FAQ match.
# Lower = more questions accepted but more false positives;
# higher = stricter but more false negatives. Valid range: 0.0 - 1.0
SIMILARITY_THRESHOLD=0.35

# Maximum user-question length in characters. Must stay in sync with the
# frontend input's maxlength attribute (currently 500).
FAQ_MAX_QUESTION_LENGTH=500

# Maximum accepted request body size in bytes (denial-of-service protection).
FAQ_MAX_CONTENT_LENGTH=16384